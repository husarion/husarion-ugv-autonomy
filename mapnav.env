# Environment of the map-nav containers (compose.mapnav.yaml). The `.env` beside it belongs to
# the older compose files and is left as it is.
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# Cyclone reads CYCLONEDDS_URI (`.env`'s CYCLONE_DDS_URI is a misspelling Cyclone never reads).
CYCLONEDDS_URI=file:///config/mapnav/cyclonedds.xml
